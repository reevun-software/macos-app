{
  "name": "reevun-macos",
  "productName": "Reevun",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Reevun for macOS",
  "author": "Reevun Software LLC",
  "main": "dist/main.js",
  "scripts": {
    "core": "npm --prefix ../app-core ci && npm --prefix ../app-core run build && node -e \"require('fs').cpSync('../app-core/dist','dist/core',{recursive:true})\"",
    "build": "npm run core && tsc",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "http-cache-semantics": "^4.3.0"
  },
  "build": {
    "appId": "app.reevun.desktop",
    "productName": "Reevun",
    "copyright": "© Reevun Software LLC",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "artifactName": "Reevun.${ext}"
    }
  }
}
